# Production — copy to terraform.tfvars and fill in values
# DO NOT commit terraform.tfvars with secrets

# ── Cluster domain ───────────────────────────────────────────────────────────
# Public DNS: vpn.maze.trading → OVH LB floating IP (UDP 31820 only).
# App hostnames resolve via WireGuard DNS → CoreDNS (no public HTTP/HTTPS).
cluster_domain = "maze.trading"

# ── Kubernetes access ────────────────────────────────────────────────────────
kubeconfig_context = "production"

# ── OVH API (or export OVH_* ; Makefile maps them to TF_VAR_ovh_*) ────────────
# https://api.ovh.com/createToken/
# Rights: /cloud/project/<id>/* AND DNS-01:
#   GET/PUT/POST/DELETE /domain/zone/*
#   GET/PUT/POST/DELETE /domain/zone/<zone>/*
ovh_cloud_project_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ovh_endpoint           = "ovh-eu"
# ovh_application_key    = "..."
# ovh_application_secret = "..."
# ovh_consumer_key       = "..."

# ── Public Cloud LB (WireGuard UDP only; managed in ovh_lb.tf) ───────────────
# ovh_lb_enabled = true
# ovh_lb_region = "UK1"
# ovh_lb_floating_ip_id = "..."  # keep existing VIP
# ovh_lb_gateway_id     = "..."

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Production uses in-cluster Bitnami Postgres for Keycloak and GitLab.
# Optional overrides (defaults are fine for in-cluster):
# gitlab_postgresql_username = "gitlab_prod"
# gitlab_postgresql_database = "gitlab_production"
# gitlab_postgresql_password = "..."
# External PG (unused unless use_external_* is true in main.tf):
# keycloak_postgresql_host / port / username / database / password
# gitlab_postgresql_host / port

# Legacy Public Cloud managed PostgreSQL vars (unused — removed from ovh.tf)
# ovh_postgresql_region / plan / flavor / version / ovh_database_allowed_cidrs


# Object Storage for Velero (created by OpenTofu)
# ovh_object_storage_region    = "GRA"
# ovh_object_storage_dr_region = "SBG"
backup_s3_bucket    = "maze-cluster-backup-production"
# backup_s3_dr_bucket = "maze-cluster-backup-production-sbg"
# backup_encryption_password = "..."  # openssl rand -base64 32 — store offline

# ── WireGuard peers ──────────────────────────────────────────────────────────
# AllowedIPs must include the bare-metal private CIDR so SSH to 192.168.10.x
# goes through the tunnel (default already includes 192.168.0.0/16).
# wireguard_allowed_ips = "10.8.0.0/24,10.96.0.0/12,10.244.0.0/16,192.168.0.0/16"
# wireguard_peers = "admin"

# ── Bootstrap admin (configure BEFORE first deploy) ──────────────────────────
# keycloak_admin_username = "admin"
# keycloak_admin_password = "..."
# bootstrap_admin = {
#   username = "backnight"
#   password = "..."
#   email    = "admin@maze.trading"  # keep stable for GitLab root SSO link
# }
# keycloak_admin_* = master-realm break-glass (offline), not daily SSO


# ── Rook-Ceph storage ────────────────────────────────────────────────────────
storage_nodes = [
  { name = "bm-01", devices = ["/dev/sdb"] },
  { name = "bm-02", devices = ["/dev/sdb"] },
  { name = "bm-03", devices = ["/dev/sdb"] },
]

# ── TLS ──────────────────────────────────────────────────────────────────────
# letsencrypt_email = "admin@maze.trading"
