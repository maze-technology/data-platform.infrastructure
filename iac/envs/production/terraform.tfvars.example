# Production — copy to terraform.tfvars and fill in values
# DO NOT commit terraform.tfvars with secrets

# ── Cluster domain ───────────────────────────────────────────────────────────
# DNS A/AAAA for *.maze.trading → OVH LB floating IP; LB backends = node:30080 / :30443
cluster_domain = "maze.trading"

# ── Kubernetes access ────────────────────────────────────────────────────────
kubeconfig_context = "production"

# ── OVH API (or export OVH_APPLICATION_KEY / SECRET / CONSUMER_KEY) ───────────
# Create tokens at https://api.ovh.com/createToken/
# Rights needed: GET/POST/PUT/DELETE on /cloud/project/<id>/*
ovh_cloud_project_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ovh_endpoint           = "ovh-eu"
# ovh_application_key    = "..."
# ovh_application_secret = "..."
# ovh_consumer_key       = "..."

# Managed PostgreSQL (created by OpenTofu — Keycloak + GitLab DBs/users)
# ovh_postgresql_region  = "UK"
# ovh_postgresql_plan    = "essential"   # or business / enterprise
# ovh_postgresql_flavor  = "db1-7"
# ovh_postgresql_version = "16"
ovh_database_allowed_cidrs = [
  { description = "bm-01-public", cidr = "x.x.x.x/32" },
  { description = "bm-02-public", cidr = "x.x.x.x/32" },
  { description = "bm-03-public", cidr = "x.x.x.x/32" },
  { description = "jump-host", cidr = "x.x.x.x/32" },
  { description = "vrack-private", cidr = "192.168.0.0/16" },
]

# Object Storage for Velero (created by OpenTofu)
# ovh_object_storage_region = "GRA"
backup_s3_bucket = "maze-cluster-backup-production"
# backup_encryption_password = "..."  # openssl rand -base64 32 — store offline

# ── Bootstrap admin (configure BEFORE first deploy) ──────────────────────────
# keycloak_admin_username = "admin"
# keycloak_admin_password = "..."
# bootstrap_admin = {
#   username = "admin"
#   password = "..."
#   email    = "admin@maze.trading"
# }

# ── Rook-Ceph storage ────────────────────────────────────────────────────────
storage_nodes = [
  { name = "bm-01", devices = ["/dev/sdb"] },
  { name = "bm-02", devices = ["/dev/sdb"] },
  { name = "bm-03", devices = ["/dev/sdb"] },
]

# ── TLS ──────────────────────────────────────────────────────────────────────
# letsencrypt_email = "admin@maze.trading"
