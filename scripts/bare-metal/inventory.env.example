# Copy to inventory.env (gitignored) and fill in real values:
#   cp scripts/bare-metal/inventory.env.example scripts/bare-metal/inventory.env
#
# Or point at another file:
#   export BARE_METAL_INVENTORY=/path/to/inventory.env

# Short hostnames (Kubernetes node names)
export BM01_NAME=bm-01
export BM02_NAME=bm-02
export BM03_NAME=bm-03

# Public hostnames or IPs used for SSH
export BM01_SSH=bm-01.example.invalid
export BM02_SSH=bm-02.example.invalid
export BM03_SSH=bm-03.example.invalid

# Public IPs (API SANs, kubeconfig rewrite)
export BM01_PUBLIC=203.0.113.11
export BM02_PUBLIC=203.0.113.12
export BM03_PUBLIC=203.0.113.13

# Private IPs (vRack / private VLAN)
export BM01_PRIVATE=192.168.10.1
export BM02_PRIVATE=192.168.10.2
export BM03_PRIVATE=192.168.10.3
export VRACK_CIDR=192.168.0.0/16
export VRACK_VLAN=1
export VRACK_GW=192.168.0.1
# WireGuard client subnet (SSH allowlist + peer AllowedIPs)
export VPN_CIDR="${VPN_CIDR:-10.8.0.0/24}"

# Ingress VIP (e.g. cloud load balancer floating IP)
export LB_FLOATING_IP=203.0.113.100

# SSH
export SSH_USER=ubuntu
export SSH_KEY="${SSH_KEY:-$HOME/.ssh/ovh_maze}"

# Kubernetes
export K8S_VERSION="${K8S_VERSION:-1.32}"
export POD_CIDR="${POD_CIDR:-10.244.0.0/16}"
export SERVICE_CIDR="${SERVICE_CIDR:-10.96.0.0/12}"
# Stable API endpoint for kubeadm HA (private IP of first CP until dedicated API LB)
export CONTROL_PLANE_ENDPOINT="${CONTROL_PLANE_ENDPOINT:-${BM01_PRIVATE}:6443}"
